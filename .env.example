# Copy this file to .env and fill in your values
# Never commit .env to version control

# Database — "db" is the Docker-internal service name, do not change the hostname
DB_URL=jdbc:postgresql://db:5432/slate
DB_USER=slate
DB_PASSWORD=change_me

# Generate with: openssl rand -base64 64
JWT_SECRET=your-base64-encoded-secret-min-256-bits

# Token TTLs (optional — defaults shown)
JWT_EXPIRY_MS=900000           # 15 minutes
JWT_REFRESH_EXPIRY_MS=2592000000  # 30 days

# CORS — URL of your Next.js frontend
CORS_ALLOWED_ORIGINS=https://slate.jodegen.de
